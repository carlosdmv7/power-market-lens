# Copied to .env by `make install`; .env is git-ignored.
# Every key: what it is, where to get it, and whether it's required.

# ── App ───────────────────────────────────────────────────────────────────────
# dev → MotherDuck database power_dev; prod → power_prod. Only the main-branch
# pipeline runs with prod.
APP_ENV=dev
LOG_LEVEL=INFO
# Days re-pulled on every run to capture publisher revisions (ADR-0003).
TRAILING_WINDOW_DAYS=7

# ── Secrets (required) ────────────────────────────────────────────────────────
# MotherDuck: https://app.motherduck.com → Settings → Access Tokens.
# DuckDB and dbt also read it straight from the environment for `md:` paths.
MOTHERDUCK_TOKEN=
# ENTSO-E: register at https://transparency.entsoe.eu, email transparency@entsoe.eu
# with subject "Restful API access", then My Account Settings → Web API Security Token.
ENTSOE_API_KEY=

# ── Prefect Cloud (only to report flow runs to the UI) ────────────────────────
# https://app.prefect.cloud → profile → API keys. Leave both empty to run flows
# locally without reporting to Cloud.
PREFECT_API_KEY=
PREFECT_API_URL=
