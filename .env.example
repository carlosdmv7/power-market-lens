# Copied to .env by `make install`; .env is git-ignored.
# Every key: what it is, where to get it, and whether it's required.

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=INFO

# ── Secrets (required) ────────────────────────────────────────────────────────
# MOTHERDUCK_TOKEN=   # https://app.motherduck.com → Settings → Access Tokens
